<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Runs on phones/tablets/emulators too, so automotive hardware is not required. -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- FM plays the broadcasters' official internet simulcasts -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".RadioApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PleosRadio"
        tools:targetApi="34">

        <!-- Optional android.car library (UX restrictions for TV video); absent on phones. -->
        <uses-library android:name="android.car" android:required="false" />

        <!-- Glanceable media UI: allowed while driving on AAOS. -->
        <meta-data android:name="distractionOptimized" android:value="true" />

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
    </application>
</manifest>
